{
  "name": "elzatona",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:types": "node scripts/database.mjs types",
    "format": "prettier --write src scripts tests supabase/tests docs *.ts *.json README.md",
    "format:check": "prettier --check src scripts tests supabase/tests docs *.ts *.json README.md",
    "check:env": "node scripts/check-env.mjs",
    "test:integration": "node tests/live-supabase.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
