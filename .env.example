NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional fallback only: server-only secret/service-role key. Not needed with the managed function.
SUPABASE_SECRET_KEY=
# Preferred: managed Supabase function; no app server secret required.
SUPABASE_STORAGE_FUNCTION=resource-files

# Optional build-time path prefix. Leave empty for the official root-domain platform.
NEXT_PUBLIC_BASE_PATH=
# Managed username/password admin authentication. Deploy the supplied function.
SUPABASE_ADMIN_FUNCTION=admin-session
